# ---- X backend configuration ------------------------------------------------
# development | test | production. Production refuses to start with unsafe settings.
X_ENV=development
# PostgreSQL in production (Render supplies postgres://… which is accepted). SQLite for local dev.
DATABASE_URL=sqlite:///./x_dev.db
# Optional: shared rate limiting across instances.
REDIS_URL=
# ≥32 random characters. python -c "import secrets; print(secrets.token_urlsafe(48))"
X_SECRET_KEY=change-me
# Fernet key for credential encryption (required in production; never change once credentials are stored).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
X_ENCRYPTION_KEY=
X_FRONTEND_ORIGIN=http://localhost:3000
X_COOKIE_SECURE=false
X_SESSION_HOURS=12
# Run jobs inside the API process (single-process dev). Use a separate worker in production.
X_EMBEDDED_WORKER=true
# First super administrator, created on start if absent. Password: ≥12 chars, mixed case, a digit.
X_BOOTSTRAP_ADMIN_EMAIL=
X_BOOTSTRAP_ADMIN_PASSWORD=
X_ALLOW_REGISTRATION=false
X_UPLOAD_MAX_BYTES=10485760
X_DEFAULT_MAX_COST_USD=0
X_EXECUTION_TIMEOUT_S=900
X_RATE_LIMIT_PER_MIN=120
X_LOGIN_RATE_LIMIT_PER_MIN=10
# Optional bootstrap of AI providers (stored encrypted in the DB on first start; manage later in Admin).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Quantum credentials are entered in Admin → Quantum Management (stored encrypted), not here.
